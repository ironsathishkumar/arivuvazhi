NODE_ENV=development
PORT=4000
# Atlas Local (docker-compose) needs directConnection=true
MONGODB_URI=mongodb://localhost:27017/arivuvazhi?directConnection=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed browser origins (admin portal)
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the API (0 when exposed directly)
TRUST_PROXY=0

# Used by `pnpm seed` to create the first super admin
SEED_SUPER_ADMIN_EMAIL=admin@arivuvazhi.local
SEED_SUPER_ADMIN_PASSWORD=change-me-please
